# Both the host replay and the ESP32 link the same measured radio responses.
# Put the bytes in read-only memory. They require halfword alignment on Xtensa.
set(asset_files)
set(assembly "")
foreach(pair IN ITEMS "shape,pre-latch" "measured,sequence-latch-rf"
        "registers,sequence-latch" "standard,sequence-1090-interior"
        "fast,sequence-1090-fast-interior" "short_reply,sequence-short")
    string(REPLACE "," ";" fields "${pair}")
    list(GET fields 0 symbol)
    list(GET fields 1 basename)
    set(path "${CMAKE_CURRENT_LIST_DIR}/${basename}.bin")
    list(APPEND asset_files "${path}")
    string(APPEND assembly ".balign 4\n.globl SYM(${symbol}_data)\nSYM(${symbol}_data):\n")
    if(symbol STREQUAL "standard" OR symbol STREQUAL "fast")
        set(base "${CMAKE_CURRENT_LIST_DIR}/sequence-latch-rf.bin")
        file(SIZE "${path}" overlay_size)
        if(NOT overlay_size EQUAL 5120)
            message(FATAL_ERROR "Wrong interior model size: ${path}")
        endif()
        set(start 0)
        foreach(phase RANGE 0 19)
            math(EXPR offset "1296 + 1792 * ${phase}")
            math(EXPR length "${offset} - ${start}")
            math(EXPR overlay "256 * ${phase}")
            string(APPEND assembly ".incbin \"${base}\", ${start}, ${length}\n.incbin \"${path}\", ${overlay}, 256\n")
            math(EXPR start "${offset} + 256")
        endforeach()
        string(APPEND assembly ".incbin \"${base}\", ${start}\n")
    else()
        string(APPEND assembly ".incbin \"${path}\"\n")
    endif()
    string(APPEND assembly ".globl SYM(${symbol}_end)\nSYM(${symbol}_end):\n")
endforeach()
set(assets "${CMAKE_CURRENT_BINARY_DIR}/models.S")
configure_file("${CMAKE_CURRENT_LIST_DIR}/models.S.in" "${assets}" @ONLY)
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_source_files_properties("${assets}" PROPERTIES OBJECT_DEPENDS "${asset_files}")
endif()
